generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  age        Int
  bio        String
  location   String
  occupation String
  interests  String   // JSON stringified array
  photos     String   // JSON stringified array of URLs
  createdAt  DateTime @default(now())

  sentSwipes     Swipe[] @relation("SentSwipes")
  receivedSwipes Swipe[] @relation("ReceivedSwipes")
  matchesAsUser1 Match[] @relation("User1Matches")
  matchesAsUser2 Match[] @relation("User2Matches")
}

model Swipe {
  id        String   @id @default(cuid())
  swiperId  String
  swipedId  String
  direction String   // "LEFT" | "RIGHT"
  createdAt DateTime @default(now())

  swiper User @relation("SentSwipes", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped User @relation("ReceivedSwipes", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
}

model Match {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
}